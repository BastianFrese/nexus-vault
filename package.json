{
  "name": "nexus-vault",
  "version": "0.2.1",
  "description": "Bastians Vault als Nexus: das Mockup-HTML 1:1, mit echten Vault-Daten, live.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/selbsttest.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.bastianfrese.nexusvault",
    "productName": "Nexus Vault",
    "directories": {
      "output": "dist"
    },
    "artifactName": "Nexus-Vault-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "editor-preload.js",
      "editor.html",
      "assets/**/*",
      "core/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "BastianFrese",
      "repo": "nexus-vault",
      "releaseType": "release"
    }
  },
  "author": "Bastian Frese (mit Claude Code)",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.18.0"
  }
}
